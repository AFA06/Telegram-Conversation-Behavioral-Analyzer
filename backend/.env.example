# Copy this file to backend/.env and fill in values. Never commit .env.
# All of these have sensible defaults (see app/config.py) — you only need
# to set what you want to change.

# SQLite database location (default: data/analyzer.db under the repo root)
# DATABASE_URL=sqlite:///../data/analyzer.db

# Default timezone used for new installs (changeable later in Settings)
DEFAULT_TIMEZONE=Asia/Tashkent

# Default analysis parameters (all changeable later in Settings)
DEFAULT_GROUPING_WINDOW_MINUTES=5
DEFAULT_SESSION_GAP_HOURS=6
DEFAULT_MIN_SAMPLE_SIZE=10

# Dashboard origin allowed by CORS
DASHBOARD_ORIGIN=http://localhost:5173

# --- Optional Telegram bot (Phase 7) ---
# Get a token from @BotFather on Telegram. NEVER commit a real token.
TELEGRAM_BOT_TOKEN=
BOT_BACKEND_URL=http://127.0.0.1:8000
